# cp .env.example .env, then fill in. run.sh passes this file to harbor with --env-file.

# Agent under evaluation (only the one your config uses): claude-code reads the Anthropic
# variables, codex the OpenAI ones. *_BASE_URL routes through a proxy.
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=
# OPENAI_BASE_URL=

# Judge: any OpenAI-compatible endpoint.
OPENAI_API_KEY=
OPENAI_API_BASE=

# Optional judge settings (defaults shown).
# JUDGE_API_KEY=            # defaults to OPENAI_API_KEY
# JUDGE_BASE_URL=           # defaults to OPENAI_API_BASE
# JUDGE_MODEL=openai/gpt-6.1-sol
# JUDGE_REASONING_EFFORT=high
# JUDGE_VOTES=3
