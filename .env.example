# cp .env.example .env, then fill in. The same file serves qa, rf and tw, the scripts in
# run_config/ and a plain `harbor run --env-file .env`.
# An empty assignment such as ANTHROPIC_API_KEY= overrides a key exported in the shell.

# Agent under evaluation. claude-code reads the Anthropic variables; codex and mini-swe-agent read
# the OpenAI ones.
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=
# OPENAI_BASE_URL=

# Hostname of the agent's API endpoint, without https:// or a path (e.g. api.anthropic.com).
# rf and tw allow only this host during the agent run; qa also allows package registries.
# pass_k.sh passes it as --allow-agent-host, a plain `harbor run` needs that flag. Not needed for
# oracle and nop.
HARBOR_AGENT_ALLOWED_HOST=

# Judge, any OpenAI-compatible endpoint.
OPENAI_API_KEY=
OPENAI_API_BASE=

# Optional judge settings (defaults shown).
# JUDGE_API_KEY=            # defaults to OPENAI_API_KEY
# JUDGE_BASE_URL=           # defaults to OPENAI_API_BASE
# JUDGE_MODEL=openai/gpt-6.1-sol
# JUDGE_REASONING_EFFORT=high
# JUDGE_VOTES=3

# Optional run settings for run_config/ (defaults shown).
# K=3                       # attempts per task (pass_k.sh)
# EFFORT=high               # agent reasoning effort (pass_k.sh)
# RESULTS_DIR=results       # results/<lane>/<job> in the repo
